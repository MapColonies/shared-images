{
  "name": "shared-images",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "npm run lint:python && npm run lint:docker",
    "lint:python": "python3 -m ruff check .",
    "lint:python:fix": "python3 -m ruff check --fix .",
    "lint:docker": "find . -type f -name '*Dockerfile*' -print0 | xargs -0 -I {} sh -c 'echo \"Linting {}\" && docker run --rm -i hadolint/hadolint < {}'",
    "format": "prettier --write . && npm run format:python",
    "format:check": "prettier --check . && npm run format:python:check",
    "format:python": "python3 -m ruff format .",
    "format:python:check": "python3 -m ruff format --check .",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MapColonies/shared-images.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/MapColonies/shared-images/issues"
  },
  "homepage": "https://github.com/MapColonies/shared-images#readme",
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@map-colonies/prettier-config": "^1.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "pretty-quick": "^4.2.2"
  }
}
